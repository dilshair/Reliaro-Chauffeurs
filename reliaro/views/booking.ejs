<% pageTitle = 'Book Your Ride'; %>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="page-main">
  <div class="container" style="max-width:720px">
    <div class="page-header">
      <a href="/" class="back-link">← Back</a>
      <h1>Complete Your Booking</h1>
      <p>Fill in your details below. We'll send confirmation within 60 minutes.</p>
    </div>

    <% if (error) { %>
    <div class="alert alert-error" role="alert"><%= error %></div>
    <% } %>

    <!-- Journey summary (pre-filled from calculator) -->
    <% if (prefill && prefill.vehicleClass) { %>
    <div class="booking-summary">
      <div class="booking-summary-row">
        <div><p class="summary-label">Vehicle</p><p class="summary-val"><%= prefill.vehicleClass %></p></div>
        <div><p class="summary-label">Route</p><p class="summary-val"><%= prefill.pickup %> → <%= prefill.dropoff %></p></div>
        <div><p class="summary-label">Fixed Price</p><p class="summary-price">$<%= Number(prefill.totalPrice || 0).toFixed(2) %></p></div>
      </div>
    </div>
    <% } %>

    <form action="/booking" method="POST" class="form-card" id="booking-form">
      <!-- Hidden journey fields from calculator -->
      <input type="hidden" name="service"       value="<%= prefill.service || prefill.vehicleClass || '' %>">
      <input type="hidden" name="vehicleClass"  value="<%= prefill.vehicleClass || '' %>">
      <input type="hidden" name="pickup"        value="<%= prefill.pickup || '' %>">
      <input type="hidden" name="dropoff"       value="<%= prefill.dropoff || '' %>">
      <input type="hidden" name="date"          value="<%= prefill.date || '' %>">
      <input type="hidden" name="time"          value="<%= prefill.time || '' %>">
      <input type="hidden" name="passengers"    value="<%= prefill.passengers || '1' %>">
      <input type="hidden" name="distanceKm"   value="<%= prefill.distanceKm || '' %>">
      <input type="hidden" name="durationMins" value="<%= prefill.durationMins || '' %>">
      <input type="hidden" name="basePrice"    value="<%= prefill.basePrice || '' %>">
      <input type="hidden" name="tollCost"     value="<%= prefill.tollCost || '' %>">
      <input type="hidden" name="surchargeAmt" value="<%= prefill.surchargeAmt || '' %>">
      <input type="hidden" name="gst"          value="<%= prefill.gst || '' %>">
      <input type="hidden" name="totalPrice"   value="<%= prefill.totalPrice || '' %>">

      <div class="form-section-title">Your Details</div>
      <div class="form-row">
        <div class="form-group"><label for="firstName">First Name *</label><input type="text" id="firstName" name="firstName" required autocomplete="given-name" value="<%= user ? user.name.split(' ')[0] : '' %>"></div>
        <div class="form-group"><label for="lastName">Last Name *</label><input type="text" id="lastName" name="lastName" required autocomplete="family-name" value="<%= user ? user.name.split(' ').slice(1).join(' ') : '' %>"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label for="email">Email Address *</label><input type="email" id="email" name="email" required autocomplete="email" value="<%= user ? user.email : '' %>"></div>
        <div class="form-group"><label for="phone">Phone Number *</label><input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="+61 4xx xxx xxx"></div>
      </div>

      <% if (!user) { %>
      <div class="form-hint">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <a href="/auth/login?next=/booking?<%= new URLSearchParams(prefill).toString() %>">Sign in</a> to save this booking to your account and view it later.
      </div>
      <% } %>

      <div class="form-section-title" style="margin-top:1.5rem">Journey Details</div>
      <% if (!prefill.vehicleClass) { %>
      <div class="form-group">
        <label for="service">Service Type *</label>
        <select id="service" name="service" required>
          <option value="" disabled selected>Select a service…</option>
          <option value="Airport Transfer — Tullamarine">Airport Transfer — Tullamarine</option>
          <option value="Airport Transfer — Avalon">Airport Transfer — Avalon</option>
          <option value="Corporate Travel">Corporate Travel</option>
          <option value="Hourly Hire">Hourly Hire</option>
          <option value="Wedding Transport">Wedding & Event Transport</option>
          <option value="Other">Other</option>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group"><label for="pickup-vis">Pickup Location *</label><input type="text" id="pickup-vis" name="pickup" required placeholder="e.g. Melbourne Airport T2" value="<%= prefill.pickup || '' %>"></div>
        <div class="form-group"><label for="dropoff-vis">Drop-off Location *</label><input type="text" id="dropoff-vis" name="dropoff" required placeholder="e.g. 101 Collins St" value="<%= prefill.dropoff || '' %>"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label for="date-vis">Date</label><input type="date" id="date-vis" name="date" value="<%= prefill.date || '' %>"></div>
        <div class="form-group"><label for="time-vis">Pickup Time</label><input type="time" id="time-vis" name="time" value="<%= prefill.time || '09:00' %>"></div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="passengers-vis">Passengers</label>
          <select id="passengers-vis" name="passengers">
            <% [1,2,3,4,5,6].forEach(n => { %><option value="<%= n %>" <%= prefill.passengers == n ? 'selected' : '' %>><%= n %> passenger<%= n > 1 ? 's' : '' %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="luggage">Luggage</label>
          <select id="luggage" name="luggage">
            <option value="None">No luggage</option>
            <option value="1 bag">1 bag</option><option value="2 bags">2 bags</option>
            <option value="3 bags">3 bags</option><option value="4+ bags">4+ bags</option>
          </select>
        </div>
      </div>
      <% } else { %>
      <!-- Editable visible fields when pre-filled from calculator -->
      <div class="form-row">
        <div class="form-group">
          <label>Pickup</label>
          <input type="text" value="<%= prefill.pickup %>" readonly class="input-readonly">
        </div>
        <div class="form-group">
          <label>Drop-off</label>
          <input type="text" value="<%= prefill.dropoff %>" readonly class="input-readonly">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Date</label><input type="text" value="<%= prefill.date || 'Not specified' %>" readonly class="input-readonly"></div>
        <div class="form-group"><label>Time</label><input type="text" value="<%= prefill.time || 'Not specified' %>" readonly class="input-readonly"></div>
      </div>
      <div class="form-group"><label>Passengers</label><input type="text" value="<%= prefill.passengers || 1 %>" readonly class="input-readonly"></div>
      <div class="form-group">
        <label for="luggage">Luggage</label>
        <select id="luggage" name="luggage">
          <option value="None">No luggage</option>
          <option value="1 bag">1 bag</option><option value="2 bags">2 bags</option>
          <option value="3 bags">3 bags</option><option value="4+ bags">4+ bags</option>
        </select>
      </div>
      <% } %>

      <div class="form-group" style="margin-top:.5rem">
        <label for="notes">Additional Notes</label>
        <textarea id="notes" name="notes" rows="3" placeholder="Flight number, child seat, special requests, return trip…"></textarea>
      </div>

      <!-- Payment -->
      <div class="form-section-title" style="margin-top:1.5rem">Payment</div>
      <div class="payment-options">
        <label class="payment-opt">
          <input type="radio" name="paymentMethod" value="stripe" checked>
          <div class="payment-opt-content">
            <div class="payment-opt-header">
              <strong>Pay Now — Secure Card Payment</strong>
              <div class="card-icons" aria-label="Visa, Mastercard, Amex accepted">
                <span>VISA</span><span>MC</span><span>AMEX</span>
              </div>
            </div>
            <p>Pay securely via Stripe. Your booking is instantly confirmed.</p>
          </div>
        </label>
        <label class="payment-opt">
          <input type="radio" name="paymentMethod" value="invoice">
          <div class="payment-opt-content">
            <strong>Request Invoice</strong>
            <p>We'll confirm your booking and send an invoice within 60 minutes.</p>
          </div>
        </label>
      </div>

      <% if (prefill.totalPrice) { %>
      <div class="price-summary">
        <div class="price-summary-row"><span>Base fare</span><span>$<%= Number(prefill.basePrice || 0).toFixed(2) %></span></div>
        <% if (Number(prefill.tollCost) > 0) { %><div class="price-summary-row"><span>Tolls (est.)</span><span>$<%= Number(prefill.tollCost).toFixed(2) %></span></div><% } %>
        <% if (Number(prefill.surchargeAmt) > 0) { %><div class="price-summary-row"><span>Surcharge</span><span>$<%= Number(prefill.surchargeAmt).toFixed(2) %></span></div><% } %>
        <div class="price-summary-row"><span>GST (10%)</span><span>$<%= Number(prefill.gst || 0).toFixed(2) %></span></div>
        <div class="price-summary-row price-total-row"><span>Total (fixed)</span><span>$<%= Number(prefill.totalPrice).toFixed(2) %></span></div>
      </div>
      <% } %>

      <button type="submit" class="btn btn-gold btn-full btn-lg" id="book-btn">
        Confirm Booking<% if (prefill.totalPrice) { %> — $<%= Number(prefill.totalPrice).toFixed(2) %><% } %>
      </button>
      <p class="form-privacy"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>Your details are private and only used to process your booking.</p>
    </form>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
<script>
document.getElementById('booking-form')?.addEventListener('submit', e => {
  const btn = document.getElementById('book-btn');
  if (btn) { btn.disabled = true; btn.textContent = 'Processing…'; }
});
</script>
</body></html>
