<% pageTitle = 'All Bookings'; extraCss = '/css/dashboard.css'; bodyClass = 'admin-body'; %>
<%- include('../../partials/head') %>
<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="sidebar-brand"><svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="15" stroke="#C9A84C" stroke-width="1.5"/><path d="M9 21 L16 10 L23 21" stroke="#C9A84C" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><line x1="11" y1="21" x2="21" y2="21" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round"/></svg><span>Reliaro<em>Admin</em></span></div>
    <nav class="sidebar-nav" aria-label="Admin navigation">
      <a href="/admin" class="sidebar-link">Dashboard</a>
      <a href="/admin/bookings" class="sidebar-link active">Bookings</a>
      <a href="/admin/customers" class="sidebar-link">Customers</a>
      <a href="/" class="sidebar-link" target="_blank">View Website</a>
      <a href="/admin/logout" class="sidebar-link sidebar-link-logout">Sign Out</a>
    </nav>
  </aside>
  <main class="admin-main">
    <div class="admin-topbar">
      <h1 class="admin-page-title">All Bookings</h1>
      <span class="admin-user">👤 <%= admin.name %></span>
    </div>

    <!-- Filters -->
    <form class="admin-filters" method="GET">
      <input type="text" name="search" placeholder="Search reference, email, pickup…" value="<%= search || '' %>">
      <select name="status">
        <option value="">All statuses</option>
        <% ['pending','confirmed','in_progress','completed','cancelled'].forEach(s => { %>
        <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-gold">Filter</button>
      <a href="/admin/bookings" class="btn-link">Clear</a>
    </form>

    <div class="admin-card">
      <div class="admin-card-header">
        <h2>Bookings (<%= total %>)</h2>
      </div>
      <% if (bookings.length === 0) { %>
      <div class="empty-state"><p>No bookings found.</p></div>
      <% } else { %>
      <div class="table-wrap">
        <table class="admin-table">
          <thead><tr><th>Reference</th><th>Customer</th><th>Route</th><th>Date</th><th>Vehicle</th><th>Price</th><th>Payment</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% bookings.forEach(b => { %>
            <tr>
              <td><strong><%= b.reference %></strong></td>
              <td><%= b.guest_first_name %> <%= b.guest_last_name %><br><small class="text-muted"><%= b.guest_email %></small></td>
              <td class="route-cell"><%= b.pickup %> → <%= b.dropoff %></td>
              <td><%= b.date || '—' %></td>
              <td><%= b.vehicle_class %></td>
              <td>$<%= Number(b.total_price).toFixed(2) %></td>
              <td><span class="status-badge status-<%= b.payment_status %>"><%= b.payment_status %></span></td>
              <td><span class="status-badge status-<%= b.status %>"><%= b.status %></span></td>
              <td><a href="/admin/bookings/<%= b.id %>" class="btn-link">Manage</a></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <!-- Pagination -->
      <% if (total > limit) { %>
      <div class="pagination">
        <% if (page > 1) { %><a href="?page=<%= page-1 %>&status=<%= status||'' %>&search=<%= search||'' %>" class="btn-link">← Prev</a><% } %>
        <span>Page <%= page %> of <%= Math.ceil(total/limit) %></span>
        <% if (page * limit < total) { %><a href="?page=<%= page+1 %>&status=<%= status||'' %>&search=<%= search||'' %>" class="btn-link">Next →</a><% } %>
      </div>
      <% } %>
      <% } %>
    </div>
  </main>
</div>
<script src="/js/main.js"></script>
</body></html>
