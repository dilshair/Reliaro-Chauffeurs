<% pageTitle = 'Admin Dashboard'; extraCss = '/css/dashboard.css'; bodyClass = 'admin-body'; %>
<%- include('../partials/head') %>

<div class="admin-layout">
  <!-- Sidebar -->
  <aside class="admin-sidebar">
    <div class="sidebar-brand">
      <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="15" stroke="#C9A84C" stroke-width="1.5"/><path d="M9 21 L16 10 L23 21" stroke="#C9A84C" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><line x1="11" y1="21" x2="21" y2="21" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round"/></svg>
      <span>Reliaro<em>Admin</em></span>
    </div>
    <nav class="sidebar-nav" aria-label="Admin navigation">
      <a href="/admin" class="sidebar-link active">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Dashboard
      </a>
      <a href="/admin/bookings" class="sidebar-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        Bookings
      </a>
      <a href="/admin/customers" class="sidebar-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
        Customers
      </a>
      <a href="/" class="sidebar-link" target="_blank">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        View Website
      </a>
      <a href="/admin/logout" class="sidebar-link sidebar-link-logout">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Sign Out
      </a>
    </nav>
  </aside>

  <!-- Main content -->
  <main class="admin-main">
    <div class="admin-topbar">
      <h1 class="admin-page-title">Dashboard</h1>
      <span class="admin-user">👤 <%= admin.name %></span>
    </div>

    <!-- Stats grid -->
    <div class="admin-stats">
      <div class="admin-stat-card">
        <div class="admin-stat-icon admin-stat-icon-blue">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <div>
          <p class="admin-stat-num"><%= stats.total_bookings %></p>
          <p class="admin-stat-label">Total Bookings</p>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon admin-stat-icon-amber">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div>
          <p class="admin-stat-num"><%= stats.pending %></p>
          <p class="admin-stat-label">Pending</p>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon admin-stat-icon-green">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div>
          <p class="admin-stat-num"><%= stats.completed %></p>
          <p class="admin-stat-label">Completed</p>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon admin-stat-icon-gold">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
        </div>
        <div>
          <p class="admin-stat-num">$<%= Number(stats.revenue || 0).toFixed(0) %></p>
          <p class="admin-stat-label">Revenue (Paid)</p>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon admin-stat-icon-purple">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <div>
          <p class="admin-stat-num"><%= stats.customers %></p>
          <p class="admin-stat-label">Customers</p>
        </div>
      </div>
      <div class="admin-stat-card">
        <div class="admin-stat-icon admin-stat-icon-teal">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div>
          <p class="admin-stat-num"><%= stats.confirmed %></p>
          <p class="admin-stat-label">Confirmed</p>
        </div>
      </div>
    </div>

    <!-- Recent bookings -->
    <div class="admin-card">
      <div class="admin-card-header">
        <h2>Recent Bookings</h2>
        <a href="/admin/bookings" class="btn-link">View all →</a>
      </div>
      <% if (recent.length === 0) { %>
      <div class="empty-state"><p>No bookings yet.</p></div>
      <% } else { %>
      <div class="table-wrap">
        <table class="admin-table">
          <thead><tr><th>Reference</th><th>Customer</th><th>Route</th><th>Vehicle</th><th>Price</th><th>Payment</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% recent.forEach(b => { %>
            <tr>
              <td><strong><%= b.reference %></strong></td>
              <td><%= b.guest_first_name %> <%= b.guest_last_name %><br><small class="text-muted"><%= b.guest_email %></small></td>
              <td class="route-cell"><%= b.pickup %> → <%= b.dropoff %></td>
              <td><%= b.vehicle_class %></td>
              <td>$<%= Number(b.total_price).toFixed(2) %></td>
              <td><span class="status-badge status-<%= b.payment_status %>"><%= b.payment_status %></span></td>
              <td><span class="status-badge status-<%= b.status %>"><%= b.status %></span></td>
              <td><a href="/admin/bookings/<%= b.id %>" class="btn-link">Manage</a></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <!-- Monthly revenue -->
    <% if (monthly.length > 0) { %>
    <div class="admin-card">
      <div class="admin-card-header"><h2>Monthly Revenue</h2></div>
      <div class="table-wrap">
        <table class="admin-table">
          <thead><tr><th>Month</th><th>Bookings</th><th>Revenue (Paid)</th></tr></thead>
          <tbody>
            <% monthly.forEach(m => { %>
            <tr>
              <td><%= m.month %></td>
              <td><%= m.count %></td>
              <td>$<%= Number(m.revenue || 0).toFixed(2) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>
  </main>
</div>
<script src="/js/main.js"></script>
</body></html>
