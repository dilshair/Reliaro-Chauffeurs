<% pageTitle = 'Admin Login'; extraCss = '/css/dashboard.css'; %>
<%- include('../partials/head') %>
<main style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0D1117;padding:2rem">
  <div class="auth-card" style="background:#161C24;border:1px solid rgba(255,255,255,.08)">
    <div style="text-align:center;margin-bottom:1.5rem">
      <svg width="36" height="36" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="15" stroke="#C9A84C" stroke-width="1.5"/><path d="M9 21 L16 10 L23 21" stroke="#C9A84C" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><line x1="11" y1="21" x2="21" y2="21" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round"/></svg>
      <h1 style="color:#f0ece4;font-size:1.4rem;margin:.75rem 0 .25rem">Admin Panel</h1>
      <p style="color:#8a9099;font-size:.9rem">Reliaro Chauffeurs</p>
    </div>
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <form action="/admin/login" method="POST" class="auth-form" style="--input-bg:#1D2530;--input-border:rgba(255,255,255,.12);--input-color:#f0ece4;--label-color:#8a9099">
      <div class="form-group"><label for="email">Email</label><input type="email" id="email" name="email" required autocomplete="email"></div>
      <div class="form-group"><label for="password">Password</label><input type="password" id="password" name="password" required autocomplete="current-password"></div>
      <button type="submit" class="btn btn-gold btn-full">Sign In to Admin</button>
    </form>
    <p style="text-align:center;margin-top:1rem"><a href="/" style="color:#8a9099;font-size:.85rem">← Back to website</a></p>
  </div>
</main>
</body></html>
