<%- include('partials/head') %>
<script type="application/ld+json">{"@context":"https://schema.org","@type":"LocalBusiness","name":"Reliaro Chauffeurs","url":"https://reliarochauffeurs.com","telephone":"+61400000000","email":"bookings@reliarochauffeurs.com","address":{"@type":"PostalAddress","addressLocality":"Melbourne","addressRegion":"VIC","addressCountry":"AU"},"priceRange":"$$$","openingHours":"Mo-Su 00:00-24:00"}</script>
<%- include('partials/nav') %>

<!-- ══════ HERO + CALCULATOR ══════ -->
<section class="hero" id="home">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-inner container-wide">

    <div class="hero-text">
      <p class="eyebrow">Melbourne & Victoria · 24/7</p>
      <h1>Reliability,<br><em>refined.</em></h1>
      <p class="hero-sub">Fixed prices. Professional chauffeurs. Airport transfers, corporate travel, weddings and hourly hire — across Melbourne and Victoria.</p>
      <div class="hero-trust" aria-label="Credentials">
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Fully insured</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>Fixed prices</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>5-star rated</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>24/7 available</span>
      </div>
    </div>

    <!-- ── Price Calculator Widget ── -->
    <div class="calc-widget" id="calc-widget">
      <div class="calc-widget-header">
        <h2>Get your fixed price</h2>
        <p>Enter your journey details below</p>
      </div>

      <div class="calc-form" id="calc-form">
        <div class="calc-field">
          <label for="hero-pickup">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 010 16c-2.8 0-8-5-8-9a8 8 0 0116 0c0 4-5.2 9-8 9z"/></svg>
            Pickup Location
          </label>
          <input type="text" id="hero-pickup" class="calc-input-ac" placeholder="e.g. Melbourne Airport T2" autocomplete="off">
        </div>
        <div class="calc-field">
          <label for="hero-dropoff">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Drop-off Location
          </label>
          <input type="text" id="hero-dropoff" class="calc-input-ac" placeholder="e.g. 101 Collins St, Melbourne" autocomplete="off">
        </div>
        <div class="calc-row">
          <div class="calc-field">
            <label for="hero-date">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              Date
            </label>
            <input type="date" id="hero-date">
          </div>
          <div class="calc-field">
            <label for="hero-time">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Time
            </label>
            <input type="time" id="hero-time" value="09:00">
          </div>
          <div class="calc-field">
            <label for="hero-pax">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
              Pax
            </label>
            <select id="hero-pax">
              <option value="1">1</option><option value="2">2</option><option value="3">3</option>
              <option value="4">4</option><option value="5">5</option><option value="6">6+</option>
            </select>
          </div>
        </div>

        <div class="calc-error" id="calc-error" hidden></div>

        <button class="btn btn-gold calc-btn" id="calc-btn" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          View Prices
        </button>
      </div>

      <!-- Results -->
      <div class="calc-results" id="calc-results" hidden>
        <div class="calc-results-meta" id="calc-meta"></div>
        <div class="calc-cards" id="calc-cards"></div>
        <button class="calc-back" id="calc-back" type="button">← Change details</button>
      </div>

      <div class="calc-loading" id="calc-loading" hidden>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 11-6.219-8.56"/></svg>
        Calculating via Google Maps…
      </div>

      <p class="calc-note">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Fixed price · Includes GST · Free cancellation
      </p>
    </div>
  </div>
</section>

<!-- ══════ SERVICES ══════ -->
<section class="section section-light" id="services">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow eyebrow-dark">Our Services</p>
      <h2>Every journey, perfectly handled.</h2>
    </div>
    <div class="services-grid">
      <article class="svc-card">
        <div class="svc-num">01</div>
        <div class="svc-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-3.09-3.09A19.79 19.79 0 014.93 9.67 2 2 0 016.93 7.5h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L11.09 15.2a16 16 0 006.29 6.29l1.06-1.06a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 22.92v-6z"/></svg></div>
        <h3>Airport Transfers</h3>
        <p>Real-time flight tracking, meet & greet with name board, and 60 minutes complimentary wait time at Melbourne Tullamarine and Avalon airports.</p>
        <a href="/#prices" class="svc-link">Get a price →</a>
      </article>
      <article class="svc-card">
        <div class="svc-num">02</div>
        <div class="svc-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg></div>
        <h3>Corporate Travel</h3>
        <p>Discreet, punctual, and impeccably presented. Trusted by Melbourne's leading businesses for client transfers and executive travel.</p>
        <a href="/#prices" class="svc-link">Get a price →</a>
      </article>
      <article class="svc-card">
        <div class="svc-num">03</div>
        <div class="svc-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
        <h3>Hourly Hire</h3>
        <p>A dedicated chauffeur on standby from 2 to 24 hours. Perfect for full days of meetings, shopping, or a night out.</p>
        <a href="/#prices" class="svc-link">Get a price →</a>
      </article>
      <article class="svc-card">
        <div class="svc-num">04</div>
        <div class="svc-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg></div>
        <h3>Weddings & Events</h3>
        <p>Elegant, stress-free transport for your special day. Decorated vehicles, red carpet arrival, and bridal party packages.</p>
        <a href="/#prices" class="svc-link">Get a price →</a>
      </article>
    </div>
  </div>
</section>

<!-- ══════ STATS ══════ -->
<div class="stats-bar" aria-label="Key statistics">
  <div class="container-wide">
    <div class="stats-grid">
      <div class="stat-item"><strong>500<span>+</span></strong><p>Rides completed</p></div>
      <div class="stat-item"><strong>5.0<span>★</span></strong><p>Average rating</p></div>
      <div class="stat-item"><strong>24<span>/7</span></strong><p>Always available</p></div>
      <div class="stat-item"><strong>0<span>%</span></strong><p>Hidden fees</p></div>
    </div>
  </div>
</div>

<!-- ══════ FLEET ══════ -->
<section class="section section-light" id="fleet">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow eyebrow-dark">Our Fleet</p>
      <h2>Only the best vehicles.</h2>
      <p class="section-lead">Every vehicle is late-model, immaculately presented, and prepared before every journey with water, chargers and Wi-Fi.</p>
    </div>
    <div class="fleet-grid">
      <div class="fleet-card">
        <div class="fleet-visual"><div class="fleet-car-art fleet-car-business" aria-hidden="true"></div></div>
        <div class="fleet-info">
          <h3>Business Class</h3>
          <p>Mercedes-Benz E-Class · BMW 5 Series · Audi A6</p>
          <ul><li>Up to 3 passengers</li><li>2 large suitcases</li><li>Wi-Fi & USB charging</li></ul>
          <a href="/#prices" class="btn btn-outline-dark">View prices</a>
        </div>
      </div>
      <div class="fleet-card fleet-card-featured">
        <div class="fleet-badge">Most Popular</div>
        <div class="fleet-visual"><div class="fleet-car-art fleet-car-first" aria-hidden="true"></div></div>
        <div class="fleet-info">
          <h3>First Class</h3>
          <p>Mercedes-Benz S-Class · BMW 7 Series · Genesis G90</p>
          <ul><li>Up to 3 passengers</li><li>3 large suitcases</li><li>Premium interior & amenities</li></ul>
          <a href="/#prices" class="btn btn-gold">View prices</a>
        </div>
      </div>
      <div class="fleet-card">
        <div class="fleet-visual"><div class="fleet-car-art fleet-car-suv" aria-hidden="true"></div></div>
        <div class="fleet-info">
          <h3>SUV / Van</h3>
          <p>Mercedes-Benz V-Class · Genesis GV80 · Toyota Alphard</p>
          <ul><li>Up to 6 passengers</li><li>4+ large suitcases</li><li>Groups & families</li></ul>
          <a href="/#prices" class="btn btn-outline-dark">View prices</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════ HOW IT WORKS ══════ -->
<section class="section section-mid" id="how">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow eyebrow-dark">How It Works</p>
      <h2>Booked in minutes.</h2>
    </div>
    <div class="how-grid">
      <div class="how-step"><div class="how-num">1</div><h3>Get Your Price</h3><p>Enter your pickup and drop-off in our calculator. See fixed prices for all vehicle classes instantly.</p></div>
      <div class="how-connector" aria-hidden="true"></div>
      <div class="how-step"><div class="how-num">2</div><h3>Book & Pay</h3><p>Select your vehicle, fill in your details, and pay securely via Stripe. Or choose invoice and pay later.</p></div>
      <div class="how-connector" aria-hidden="true"></div>
      <div class="how-step"><div class="how-num">3</div><h3>Get Confirmation</h3><p>Receive an instant confirmation email with your booking reference and all journey details.</p></div>
      <div class="how-connector" aria-hidden="true"></div>
      <div class="how-step"><div class="how-num">4</div><h3>Arrive in Style</h3><p>Your chauffeur arrives early, greets you by name, and delivers you in complete comfort.</p></div>
    </div>
  </div>
</section>

<!-- ══════ COVERAGE ══════ -->
<section class="section section-dark" id="coverage">
  <div class="container">
    <div class="coverage-inner">
      <div class="coverage-text">
        <p class="eyebrow">Where We Operate</p>
        <h2>All of Melbourne & Victoria.</h2>
        <p>From the CBD to the Mornington Peninsula, Yarra Valley, Geelong, and all of regional Victoria — if you're in Victoria, we'll be there.</p>
        <a href="/#prices" class="btn btn-gold" style="margin-top:1.5rem;display:inline-flex">Check Your Route</a>
      </div>
      <div class="coverage-areas" role="list">
        <% ['Melbourne CBD','Melbourne Airport','Avalon Airport','Southbank','St Kilda','Toorak & South Yarra','Mornington Peninsula','Yarra Valley','Geelong','Dandenong Ranges','Ballarat','Bendigo','Phillip Island','Healesville','Torquay & Surf Coast','All of Victoria'].forEach(area => { %>
        <div class="coverage-area" role="listitem">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <%- area %>
        </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<!-- ══════ REVIEWS ══════ -->
<section class="section section-light" id="reviews">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow eyebrow-dark">Client Reviews</p>
      <h2>Trusted across Victoria.</h2>
    </div>
    <div class="reviews-grid">
      <article class="review-card"><div class="review-stars" aria-label="5 stars">★★★★★</div><blockquote>"Absolutely flawless service. Driver was waiting with a name board, helped with every bag, water in the car. The vehicle was immaculate. Will never use anyone else for the airport."</blockquote><footer><div class="review-av" aria-hidden="true">SR</div><div><cite class="review-name">Sarah R.</cite><span>Airport Transfer, Tullamarine</span></div></footer></article>
      <article class="review-card"><div class="review-stars" aria-label="5 stars">★★★★★</div><blockquote>"We use Reliaro for all our executive client transfers. The professionalism and presentation are second to none. Our clients always comment on how impressive the experience is."</blockquote><footer><div class="review-av" aria-hidden="true">JM</div><div><cite class="review-name">James M.</cite><span>Corporate Account, Melbourne CBD</span></div></footer></article>
      <article class="review-card"><div class="review-stars" aria-label="5 stars">★★★★★</div><blockquote>"Made our wedding day perfect. The car was stunning, driver so kind and patient, everything ran like clockwork. Highly recommend to every couple in Melbourne."</blockquote><footer><div class="review-av" aria-hidden="true">EK</div><div><cite class="review-name">Emma K.</cite><span>Wedding, Yarra Valley</span></div></footer></article>
    </div>
  </div>
</section>

<!-- ══════ CTA BAND ══════ -->
<section class="cta-band" id="prices">
  <div class="container">
    <div class="cta-band-inner">
      <div>
        <h2>Ready to book your ride?</h2>
        <p>Scroll up to the calculator, or call us any time — day or night.</p>
      </div>
      <div class="cta-band-actions">
        <a href="#home" class="btn btn-gold btn-lg" onclick="document.getElementById('home').scrollIntoView({behavior:'smooth'});return false;">
          Calculate My Price
        </a>
        <a href="tel:+61400000000" class="btn btn-ghost btn-lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-3.09-3.09A19.79 19.79 0 014.93 9.67 2 2 0 016.93 7.5h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L11.09 15.2a16 16 0 006.29 6.29l1.06-1.06a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 22.92v-6z"/></svg>
          Call Now
        </a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

<script src="/js/main.js"></script>
<script src="/js/calculator.js"></script>
<% if (googleMapsKey) { %>
<script>
  window.RELIARO_MAPS_KEY = '<%= googleMapsKey %>';
</script>
<script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsKey %>&libraries=places&callback=initReliaroMaps&loading=async" async defer></script>
<% } %>
</body></html>
