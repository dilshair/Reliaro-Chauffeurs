<footer class="site-footer">
  <div class="container-wide">
    <div class="footer-grid">
      <div class="footer-brand">
        <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <circle cx="16" cy="16" r="15" stroke="#C9A84C" stroke-width="1.2"/>
          <path d="M9 22L16 9l7 13" stroke="#C9A84C" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="11" y1="22" x2="21" y2="22" stroke="#C9A84C" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        <div class="footer-brand-name"><%= brand.shortName %><em>Chauffeurs</em></div>
        <p><%= brand.description %></p>
        <div class="footer-contact">
          <a href="tel:<%= brand.phone %>">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-3.09-3.09A19.79 19.79 0 014.93 9.67 2 2 0 016.93 7.5h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L11.09 15.2a16 16 0 006.29 6.29l1.06-1.06a2 2 0 012.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0122 22.92v-6z"/></svg>
            <%= brand.phoneDisplay %>
          </a>
          <a href="mailto:<%= brand.email %>">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <%= brand.email %>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          <% services.forEach(s => { %>
          <li><a href="/services#<%= s.id %>"><%= s.name %></a></li>
          <% }) %>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/business">For Business</a></li>
          <li><a href="/contact">Contact Us</a></li>
          <li><a href="/#calculator">Price Calculator</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Account</h4>
        <ul>
          <% if (user) { %>
          <li><a href="/account">My Dashboard</a></li>
          <li><a href="/account/bookings">My Bookings</a></li>
          <li><a href="/auth/logout">Sign Out</a></li>
          <% } else { %>
          <li><a href="/auth/login">Sign In</a></li>
          <li><a href="/auth/register">Create Account</a></li>
          <li><a href="/business">Business Account</a></li>
          <% } %>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; <%= new Date().getFullYear() %> <%= brand.name %>. All rights reserved. ABN: <%= brand.abn %></p>
      <div class="footer-social">
        <a href="<%= brand.social ? brand.social.instagram : '#' %>" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/></svg>
        </a>
        <a href="<%= brand.social ? brand.social.facebook : '#' %>" aria-label="Facebook" target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
        </a>
        <a href="<%= brand.social ? brand.social.linkedin : '#' %>" aria-label="LinkedIn" target="_blank" rel="noopener">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
      </div>
      <div class="footer-legal">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
