<header class="site-nav" id="site-nav">
  <nav class="nav-inner container-wide">
    <a href="/" class="nav-brand" aria-label="<%= brand.name %> home">
      <svg class="nav-brand-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="16" r="15" stroke="#C9A84C" stroke-width="1.2"/>
        <path d="M9 22L16 9l7 13" stroke="#C9A84C" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        <line x1="11" y1="22" x2="21" y2="22" stroke="#C9A84C" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
      <span class="nav-brand-name"><%= brand.shortName %><em>Chauffeurs</em></span>
    </a>

    <ul class="nav-links" role="list">
      <li class="nav-dropdown">
        <a href="/services" class="nav-link nav-link-drop">
          Our Services
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="nav-menu">
          <% services.forEach(s => { %>
          <a href="/services#<%= s.id %>" class="nav-menu-item">
            <span class="nav-menu-title"><%= s.name %></span>
            <span class="nav-menu-desc"><%= s.shortDesc.split('.')[0] %></span>
          </a>
          <% }) %>
        </div>
      </li>
      <li class="nav-dropdown">
        <a href="/business" class="nav-link nav-link-drop">
          For Business
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </a>
        <div class="nav-menu">
          <a href="/business" class="nav-menu-item"><span class="nav-menu-title">Overview</span><span class="nav-menu-desc">Travel built for business</span></a>
          <% businessTypes.forEach(b => { %>
          <a href="/business#<%= b.id %>" class="nav-menu-item">
            <span class="nav-menu-title"><%= b.name %></span>
            <span class="nav-menu-desc"><%= b.desc.split('.')[0] %></span>
          </a>
          <% }) %>
        </div>
      </li>
      <li><a href="/about" class="nav-link">About Us</a></li>
      <li><a href="/contact" class="nav-link">Contact</a></li>
    </ul>

    <div class="nav-actions">
      <% if (user) { %>
        <a href="/account" class="nav-signin">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          My Account
        </a>
      <% } else { %>
        <a href="/auth/login" class="nav-signin">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Sign in
        </a>
      <% } %>
      <a href="/#calculator" class="btn btn-gold btn-sm">Book now</a>
    </div>

    <button class="nav-burger" id="nav-burger" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <div class="nav-mobile" id="nav-mobile" aria-hidden="true">
    <ul role="list">
      <% nav.forEach(item => { %>
      <li><a href="<%= item.href %>"><%= item.label %></a></li>
      <% }) %>
      <li><a href="tel:<%= brand.phone %>"><%= brand.phoneDisplay %></a></li>
      <% if (user) { %>
        <li><a href="/account">My Account</a></li>
        <li><a href="/auth/logout">Sign Out</a></li>
      <% } else { %>
        <li><a href="/auth/login">Sign In</a></li>
        <li><a href="/auth/register">Create Account</a></li>
      <% } %>
    </ul>
    <a href="/#calculator" class="btn btn-gold btn-full" style="text-align:center;justify-content:center">Book Now</a>
  </div>
</header>
